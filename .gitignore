# Binaries — only bin/default/ is tracked; everything else is ignored
bin/*
!bin/default/
!bin/wine-quiet.sh

# Python cache
__pycache__/
*.py[cod]

# AI tooling
.claude/

# Markdown — ignore all except README
*.md
!README.md

# Reports
reports/*.txt

# Sample configs — only the shipped bee2 configs are tracked
samples/*
!samples/bee2recent.json
!samples/bee2old.json
!samples/bee2bash-etalon.json
!samples/bee2brng-etalon.json

# macOS metadata
.DS_Store
private
